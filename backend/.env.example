# Backend Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# GROQ
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=mixtral-8x7b-32768

# Application
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Security
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-32-byte-secret
ALLOWED_ORIGINS=http://localhost:3000,https://erizonai.com.br

# Meta Ads
META_API_VERSION=v20.0

# Canva OAuth
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
CANVA_REDIRECT_URI=http://localhost:3001/api/integrations/canva/callback
CANVA_OAUTH_URL=https://www.canva.com/api/oauth/authorize
